        <CheatEntry>
          <ID>30</ID>
          <Description>"XP Options - Enable [XP/levels update after battle, back on field]"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
aobscanmodule(WFF_XPGain,WOFF.exe,41 03 F0 3B C6 0F 42 F0 48 81 C1 98 00 00 00 E8 ?? ?? ?? ?? 48 8B 0D)
assert(WFF_XPGain,41 03 F0 3B C6)
alloc(WFF_XPCode,512,WFF_XPGain)
label(WFF_XPFactor)
label(WFF_XPMaxLevel)
label(WFF_XPOriginal)
label(WFF_XPReturn)
label(WFF_XPScaled)
label(WFF_XPClamp)
label(WFF_XPZero)
label(WFF_XPSetCap)
registersymbol(WFF_XPFactor)
registersymbol(WFF_XPMaxLevel)
registersymbol(WFF_XPGain)

WFF_XPCode:
// Here EAX is this recipient's level-99 total; R8D is current total XP.
// ESI is the recipient-specific award, after any upstream XP sharing.
test esi,esi
js WFF_XPOriginal
push r9
sub rsp,10
movups [rsp],xmm0
test esi,esi
jz WFF_XPZero
cmp byte ptr [WFF_XPMaxLevel],0
jne WFF_XPSetCap
// A 64-bit double intermediate avoids wrapping the 32-bit cumulative total.
mov r9d,esi
cvtsi2sd xmm0,r9
// Factor is Double: 0 = none, 1 = normal, 50000 = fifty thousand times.
mulsd xmm0,[WFF_XPFactor]
ucomisd xmm0,xmm0
jp WFF_XPScaled
mov r9d,eax
sub r9d,r8d
// At/past cap, leave the existing native cap check in control.
cmp eax,r8d
jbe WFF_XPZero
push rax
sub rsp,10
movups [rsp],xmm1
cvtsi2sd xmm1,r9
ucomisd xmm0,xmm1
movups xmm1,[rsp]
lea rsp,[rsp+10]
pop rax
jae WFF_XPSetCap
cvttsd2si r9,xmm0
test r9,r9
js WFF_XPZero
add r9,r8
mov esi,r9d
jmp WFF_XPClamp
WFF_XPScaled:
// Invalid (NaN) factor falls back to the unscaled award, without overflow.
mov r9d,esi
add r9,r8
mov esi,r9d
cmp r9,rax
jbe WFF_XPClamp
WFF_XPSetCap:
mov esi,eax
jmp WFF_XPClamp
WFF_XPZero:
mov esi,r8d
WFF_XPClamp:
movups xmm0,[rsp]
add rsp,10
pop r9
cmp eax,esi
jmp WFF_XPReturn
WFF_XPOriginal:
add esi,r8d
cmp eax,esi
WFF_XPReturn:
jmp WFF_XPGain+5
align 10
WFF_XPFactor:
dq (double)1.0
WFF_XPMaxLevel:
db 00

WFF_XPGain:
jmp WFF_XPCode

[DISABLE]
WFF_XPGain:
db 41 03 F0 3B C6
unregistersymbol(WFF_XPFactor)
unregistersymbol(WFF_XPMaxLevel)
unregistersymbol(WFF_XPGain)
dealloc(WFF_XPCode)
</AssemblerScript>
