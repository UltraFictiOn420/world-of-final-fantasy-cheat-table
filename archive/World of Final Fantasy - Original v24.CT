registersymbol(WFF_BalanceHud)
registersymbol(WFF_BalanceHudSeen)
aobscanmodule(WFF_BalanceWobble,WOFF.exe,F3 0F 10 89 28 2B 00 00 66 0F 6E C0 0F 5B C0)
assert(WFF_BalanceWobble,F3 0F 10 89 28 2B 00 00)
alloc(WFF_BalanceWobbleCode,256,WFF_BalanceWobble)
label(WFF_BalanceWobbleNative)
registersymbol(WFF_BalanceWobble)
WFF_BalanceWobbleCode:
pushfq
push rax
mov rax,WOFF.exe+2F4B168
cmp [rcx],rax
jne WFF_BalanceWobbleNative
cmp dword ptr [rcx+2E34],0
jne WFF_BalanceWobbleNative
cmp dword ptr [rcx+29C8],0
jle WFF_BalanceWobbleNative
test byte ptr [rcx+29A8],1
jnz WFF_BalanceWobbleNative
mov eax,[rcx+2B2C]
mov [rcx+2B28],eax
WFF_BalanceWobbleNative:
pop rax
popfq
movss xmm1,[rcx+2B28]
jmp WFF_BalanceWobble+8
WFF_BalanceHudCode:
pushfq
push rdx
mov rdx,WOFF.exe+2F4B168
cmp [rax],rdx
jne WFF_BalanceHudNative
cmp dword ptr [rax+2E34],0
jne WFF_BalanceHudNative
cmp dword ptr [rax+29C8],0
jle WFF_BalanceHudNative
test byte ptr [rax+29A8],1
jnz WFF_BalanceHudNative
// The live HUD supplies its current actor; never cache a battle pointer.
// Integer copy avoids changing any scratch XMM register or native flags.
mov edx,[rax+2B2C]
mov [rax+2B28],edx
inc dword ptr [WFF_BalanceHudSeen]
WFF_BalanceHudNative:
pop rdx
popfq
movss xmm1,[rax+2B28]
jmp WFF_BalanceHud+8
align 4
WFF_BalanceHudSeen:
dd 0
WFF_BalanceCode:
pushfq
push rax
mov rax,WOFF.exe+2F4B168
cmp [rcx],rax
jne WFF_BalanceNative
cmp dword ptr [rcx+2E34],0
jne WFF_BalanceNative
cmp dword ptr [rcx+29C8],0
jle WFF_BalanceNative
// Keep the native stack-balance setter at its own maximum, not a huge constant.
movss xmm6,[rcx+2B2C]
WFF_BalanceNative:
pop rax
popfq
movss [rcx+2B28],xmm6
jmp WFF_BalanceSet+8
WFF_BalanceSet:
jmp WFF_BalanceCode
nop 3
WFF_BalanceHud:
jmp WFF_BalanceHudCode
nop 3
WFF_BalanceWobble:
jmp WFF_BalanceWobbleCode
nop 3
[DISABLE]
WFF_BalanceWobble:
db F3 0F 10 89 28 2B 00 00
WFF_BalanceHud:
db F3 0F 10 88 28 2B 00 00
WFF_BalanceSet:
db F3 0F 11 B1 28 2B 00 00
unregistersymbol(WFF_BalanceSet)
dealloc(WFF_BalanceCode)
unregistersymbol(WFF_BalanceHud)
unregistersymbol(WFF_BalanceHudSeen)
dealloc(WFF_BalanceHudCode)
unregistersymbol(WFF_BalanceWobble)
dealloc(WFF_BalanceWobbleCode)
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>118</ID>
          <Description>"Never Miss - UNAVAILABLE [crash reported; investigation pending]"</Description>
          <Color>808080</Color>
          <GroupHeader>1</GroupHeader>
        </CheatEntry>
        <CheatEntry>
          <ID>119</ID>
          <Description>"Topple One Enemy Stack - F8 [Beep = queued; expires in 3 seconds; resume battle promptly]"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
assert(getOpenedProcessID()==getProcessIDFromProcessName('WOFF.exe'),'Attach WoFF first')
local b=assert(getAddressSafe('WOFF.exe'),'Start WoFF first')
local pe=assert(readInteger(b+0x3C))
assert(readInteger(b+pe+8)==0x5B9B7E76,'Unverified WoFF build; nothing patched')
assert(not _G.WFFTopple,'Topple is already installed')
local native=[==[__NATIVE_ENABLE__
aobscanmodule(WFF_ToppleRead,WOFF.exe,F3 0F 59 BF EC 29 00 00 F3 0F 58 BF D8 29 00 00)
assert(WFF_ToppleRead,F3 0F 59 BF EC 29 00 00)
assert(WOFF.exe+55D440,40 53 55 56 57 41 56 48 83 EC 20 33 DB 48 8B E9)
alloc(WFF_ToppleCode,1024,WFF_ToppleRead)
label(WFF_ToppleRequest)
label(WFF_ToppleSeen)
label(WFF_ToppleCalls)
label(WFF_ToppleNative)
registersymbol(WFF_ToppleRead)
registersymbol(WFF_ToppleRequest)
registersymbol(WFF_ToppleSeen)
registersymbol(WFF_ToppleCalls)
WFF_ToppleCode:
pushfq
push rbx
push rax
mov rax,rdi
test rax,rax
jz WFF_ToppleNative
mov rbx,WOFF.exe+2F4B168
cmp [rax],rbx
jne WFF_ToppleNative
mov rbx,rax
cmp dword ptr [rbx+2E34],1
jne WFF_ToppleNative
cmp dword ptr [rbx+29C8],0
jle WFF_ToppleNative
test byte ptr [rbx+29A8],2
jnz WFF_ToppleNative
mov rbx,[rax+3698]
sub rbx,[rax+3690]
cmp rbx,10
jb WFF_ToppleNative
cmp rbx,18
ja WFF_ToppleNative
inc dword ptr [WFF_ToppleSeen]
cmp dword ptr [WFF_ToppleRequest],1
jne WFF_ToppleNative
mov rbx,[WOFF.exe+3439EE0]
test rbx,rbx
jz WFF_ToppleNative
// Consume BEFORE dispatch; native callbacks cannot trigger a second collapse.
mov dword ptr [WFF_ToppleRequest],0
push rcx
push rdx
push r8
push r9
push r10
push r11
// Native actor update is aligned here. Nine pushes require an extra 8 bytes.
sub rsp,0A8
movups [rsp+40],xmm0
movups [rsp+50],xmm1
movups [rsp+60],xmm2
movups [rsp+70],xmm3
movups [rsp+80],xmm4
movups [rsp+90],xmm5
// Native binding only reads wrapper+8. Use a local view, not actor+34D8:
// that embedded object's +8 is null for observed enemy UnitTower actors.
mov qword ptr [rsp+20],0
mov [rsp+28],rax
lea rcx,[rsp+20]
call WOFF.exe+55D440
inc dword ptr [WFF_ToppleCalls]
movups xmm0,[rsp+40]
movups xmm1,[rsp+50]
movups xmm2,[rsp+60]
movups xmm3,[rsp+70]
movups xmm4,[rsp+80]
movups xmm5,[rsp+90]
add rsp,0A8
pop r11
pop r10
pop r9
pop r8
pop rdx
pop rcx
WFF_ToppleNative:
pop rax
pop rbx
popfq
mulss xmm7,[rdi+29EC]
jmp WFF_ToppleRead+8
align 10
WFF_ToppleRequest:
dd 0
WFF_ToppleSeen:
dd 0
WFF_ToppleCalls:
dd 0
WFF_ToppleRead:
jmp WFF_ToppleCode
nop 3
__NATIVE_DISABLE__
WFF_ToppleRead:
db F3 0F 59 BF EC 29 00 00
unregistersymbol(WFF_ToppleRead)
unregistersymbol(WFF_ToppleRequest)
unregistersymbol(WFF_ToppleSeen)
unregistersymbol(WFF_ToppleCalls)
dealloc(WFF_ToppleCode)
]==]
native=native:gsub('__NATIVE_ENABLE__','['..'ENABLE'..']'):gsub('__NATIVE_DISABLE__','['..'DISABLE'..']')
local ok,di=autoAssemble(native)
assert(ok,tostring(di))
local s={native=native,disableInfo=di,pid=getOpenedProcessID(),requested=0}
local installed,err=pcall(function()
 s.hotkey=createHotkey(function()
  if getOpenedProcessID()~=s.pid then return end
  local p=getAddressSafe('WFF_ToppleRequest')
  if not p or readInteger(p)~=0 then return end
  s.requested=getTickCount()
  writeInteger(p,1)
  -- Acknowledges only an accepted request, not a completed collapse.
  if type(beep)=='function' then pcall(beep) end
 end,0x77) -- F8: one enemy stack per press, no HP damage.
 s.hotkey.DelayBetweenActivate=750
 s.timer=createTimer(nil,false)
 s.timer.Interval=100
 s.timer.OnTimer=function()
  if getOpenedProcessID()~=s.pid then return end
  local p=getAddressSafe('WFF_ToppleRequest')
  -- An unconsumed request expires: no stale press waiting for a later battle.
  if p and readInteger(p)==1 and getTickCount()-s.requested&gt;3000 then
   writeInteger(p,0)
  end
 end
 s.timer.Enabled=true
end)
if not installed then
 if s.hotkey then s.hotkey.destroy() end
 if s.timer then s.timer.destroy() end
 autoAssemble(native,false,di)
 error(tostring(err))
end
_G.WFFTopple=s
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
local s=_G.WFFTopple
if not s then return end
if getOpenedProcessID()~=s.pid then error('Reattach original game before disabling Topple') end
writeInteger(getAddress('WFF_ToppleRequest'),0)
local ok,msg=autoAssemble(s.native,false,s.disableInfo)
assert(ok,tostring(msg))
if s.hotkey then s.hotkey.destroy() end
if s.timer then s.timer.destroy() end
_G.WFFTopple=nil
{$asm}
</AssemblerScript>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
  </CheatEntries>
  <UserdefinedSymbols />
  <Comments>Original implementation. DrummerIX reference CT was read for context only; addresses and machine instructions were independently checked in the running game. No third-party scripts are embedded. Enable parent first; this also installs UI-only read-only guards on grey INFO ONLY rows. Those rows cannot be frozen or edited through ordinary table controls; selectors and multiplier values remain editable. Confirmed gameplay features have no Test tag. Experimental limitations remain labelled. Disable children before parent, and disable everything before closing Cheat Engine. Gil changes remain after disabling. SP options share hooks and can be combined. XP and level changes become visible after battle, when back on the field. User confirmed foundation scripts work in gameplay on 2026-10-10. User also confirmed v3 God Mode and Infinite Battle AP work. User confirmed v4 damage and max-vitals options work. One-Hit Kill overrides the player multiplier; God Mode and Always Max override the enemy multiplier. Multipliers operate by target side, not attacker identity. Healing and zero-damage hits are not multiplied. Enable Always Max in battle; if party actors are rebuilt, retoggle it to rediscover them. Always Max does not revive KO actors; refilled values remain after disabling. v5 adds zero ability AP costs and two shared-hook item consumption modes. Infinite Usage overrides Never Below 1. Item routines may also serve non-use inventory removal; disable item options for selling, crafting, or quest hand-ins until tested. User confirmed v5 options work in gameplay. v6 adds Easy Imprism readiness and chance hooks for known enemy Mirage actors with a native capture capability. Native Prism, living-target, and other eligibility checks remain. No actor capture-state fields are edited. User confirmed v6 captures Mu; Chocochicks were blocked by missing required Prism, not their species conditions. v7 merges capture-only Prism requirement and consumption bypass into Easy Imprism to capture eligible Mirages without meeting their normal readiness condition or owning their Prism. Native living-target, capture-state, and battle restrictions remain; this does not promise boss/uncapturable support. User confirmed v7 captures a Chocochick with no Prism. v8 replacement failed: visual clone changed but ownership did not. v9 queues one successful capture and changes only its native owned-grant argument. Enable its parent, select a species, then arm. It starts disarmed. The arm flag is consumed once; toggle Arm off/on to re-arm. Status 2 means queued; finish the battle without re-arming or disabling replacement. The capture animation remains the original species. The user verified Mu-to-Chocochick and Mu-to-Goblin ownership replacement on 2026-10-10; live primary and board/form IDs agree. All battle/capture visuals may still show the original Mirage until fully out of battle: check the Mirage list afterward. Only one capture per battle is validated; other species, multiple captures and reloading saved replacements are untested. A 0 status means idle/consumed, not proof the selected species is safe or that a free ownership slot was available. Native construction receives the chosen ID; enemy IDs remain unchanged. 264 candidates were independently decoded from installed definitions; 248 are library-listed. Unused/test/outside-library entries are labelled, not certified ownable. Library membership does not guarantee safety. Back up saves and initially test a normal species. Verify appearance, board, abilities and stats before saving a replacement result. Do not freeze informational fields. Champion-cost is not implemented. v11 bypasses only the field-menu Save entry's required permission flag. Close/reopen the menu after toggling. Does not save automatically or enable battle/cutscene menus. User confirmed field saving and reloading on 2026-10-10. Other maps/story states remain untested; a separate save slot is recommended. v12 fixes disable-time address resolution. No save-writing routines or persistent event flags are modified. v15 added party status, critical and stack-balance options. User confirmed critical attacks in gameplay; the other new battle options retain TEST labels. v16 adds a reversible loaded-script normal accuracy result override for player-side attackers only. Enable Never Miss while in battle. Enemy accuracy, deliberate-miss, resurrection and capture routines are not altered. It does not bypass immunity or scripted battle rules. If the battle script VM is rebuilt, retoggle in battle. Gameplay verification is pending. v18 repairs stacked-member status propagation, includes verified Lann/Reynn classes in party status filters, and maintains native Protect/Shell counters when duration protection is selected. v22 adds selected-buff application before the native command-menu clock gate; fresh-battle immediate visuals still need user confirmation. Easy Imprism now bypasses encounter capture permission only for library-listed enemy Mirage species, including Behemoth, without changing their actor permission fields. Both native eligibility and the UI permission binding are covered; living-target, capture-state and other battle checks still run. This does not promise all bosses or scripted encounters are safe: capturing a story opponent may affect progression. Use a separate save and verify the owned Mirage after battle. User confirmed Behemoth capture succeeds with v18 on 2026-10-10. Live status masks were verified on both party stacks and all four members after Defend, with enemy status unchanged. Buff effects across later battles remain under testing. v19 adds an F8 one-shot enemy topple experiment. Enable the entry, then press F8 in battle. It dispatches the native collapse binding from the game's actor-update thread, not a CE worker thread. Only living enemy UnitTower actors with two or three members are eligible; no HP, party balance, capture or ownership fields are changed. One stack per press. Unconsumed requests expire after three seconds. If the command menu pauses battle time, press F8 immediately before choosing Defend, just before the enemy's turn. User confirmed this topples the Mini Golem/Copper Gnome stack on 2026-10-10. It is queued, not an immediate command-menu animation. Other encounters remain untested. v21: F8 beep acknowledges queuing only; requests expire after three real-time seconds, even while the command menu pauses battle updates. Never Topple provisionally user-confirmed; existing wobble may clear on the next action. Never Miss is unavailable following an unconfirmed crash report; no accuracy patch is included. v22 adds an earlier native actor-update hook for selected party buffs; it runs during command-menu waiting. Fresh-battle application confirmed on both stacks and all six members with user-reported visuals before taking an action. v23 repairs Never Topple's missing counter label declaration. Loot bypass confirmed in one five-enemy encounter: five normally failing rolls yielded four Potions and one Smelling Salts. v24 additionally bypasses first-success exclusion inside the defeated-enemy drop loop; all positive-chance alternative entries are attempted with native quantities. Four-enemy test confirmed all eight entries: four Potions, three Antidotes, one Wobblestopper; six normally failing rolls prevented. Broader encounters, status-duration behaviour and negative-status protection still need verification.</Comments>
</CheatTable>