// Shared define must be available during both enable AND disable assembly.
define(WFF_SaveDescriptor,WOFF.exe+2B02278)
[ENABLE]
{$lua}
if syntaxcheck then return end
-- Never reopen the process inside AA: it can invalidate AA's captured handle.
if getOpenedProcessID()~=getProcessIDFromProcessName('WOFF.exe') then
  error('Select WOFF.exe in Cheat Engine before enabling the table.')
end
local b=getAddressSafe('WOFF.exe')
if not b then error('Start WoFF and load a save first.') end
local pe=readInteger(b+0x3C)
if not pe or readInteger(b+pe+8)~=0x5B9B7E76 then
  error('Unverified WoFF executable build; no patches applied.')
end
{$asm}

// The native field-menu descriptor for entry 9 (Save, menu type 0B).
// Its +20 field requires event flag 0FAC. -1 means no required flag,
// exactly as used by the other unrestricted menu entries.
// Changes only this static descriptor, not the persistent event-flag store.
assert(WFF_SaveDescriptor+10,0B 00 00 00 00 00 00 00 FF FF FF FF FF FF FF FF AC 0F 00 00 00 00 00 00)
WFF_SaveDescriptor+20:
dd FFFFFFFF
[DISABLE]
WFF_SaveDescriptor+20:
dd 00000FAC
