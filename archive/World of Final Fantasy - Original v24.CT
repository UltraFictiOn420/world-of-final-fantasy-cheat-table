          <ID>40</ID>
          <Description>"Battle HP Options - Enable"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- Never reopen the process inside AA: it can invalidate AA's captured handle.
if getOpenedProcessID()~=getProcessIDFromProcessName('WOFF.exe') then
  error('Select WOFF.exe in Cheat Engine before enabling the table.')
end
local b=getAddressSafe('WOFF.exe')
if not b then error('Start WoFF and load a save first.') end
local pe=readInteger(b+0x3C)
if not pe or readInteger(b+pe+8)~=0x5B9B7E76 then
  error('Unverified WoFF executable build; no patches applied.')
end
{$asm}

aobscanmodule(WFF_HPApply,WOFF.exe,F3 0F 2C C7 66 0F 6E C0 0F 5B C0 F3 0F 5C C8 F3 0F 5F CB)
assert(WFF_HPApply,F3 0F 2C C7 66 0F 6E C0)
alloc(WFF_HPCode,1024,WFF_HPApply)
label(WFF_GodMode)
label(WFF_MaxVitals)
label(WFF_OneHit)
label(WFF_PlayerDamage)
label(WFF_EnemyDamage)
label(WFF_DamageCap)
label(WFF_HPParty)
label(WFF_HPEnemy)
label(WFF_HPScale)
label(WFF_HPZero)
label(WFF_HPCap)
label(WFF_LastHPActor)
label(WFF_HPDone)
registersymbol(WFF_HPApply)
registersymbol(WFF_GodMode)
registersymbol(WFF_MaxVitals)
registersymbol(WFF_OneHit)
registersymbol(WFF_PlayerDamage)
registersymbol(WFF_EnemyDamage)
registersymbol(WFF_LastHPActor)
WFF_HPCode:
cvttss2si eax,xmm7
pushfq
mov [WFF_LastHPActor],rbx
// Only positive HP loss to the independently observed player side is blocked.
test eax,eax
jle WFF_HPDone
cmp dword ptr [rbx+2E34],0
je WFF_HPParty
cmp dword ptr [rbx+2E34],1
je WFF_HPEnemy
jmp WFF_HPDone
WFF_HPParty:
cmp byte ptr [WFF_MaxVitals],0
jne WFF_HPZero
cmp byte ptr [WFF_GodMode],0
jne WFF_HPZero
cvtsi2sd xmm0,eax
mulsd xmm0,[WFF_EnemyDamage]
jmp WFF_HPScale
WFF_HPEnemy:
cmp byte ptr [WFF_OneHit],0
je @f
movss xmm0,[rbx+29CC]
cvtss2sd xmm0,xmm0
jmp WFF_HPScale
@@:
cvtsi2sd xmm0,eax
mulsd xmm0,[WFF_PlayerDamage]
WFF_HPScale:
// NaN falls back to native damage. Negative factors mean zero damage.
ucomisd xmm0,xmm0
jp WFF_HPDone
comisd xmm0,[WFF_DamageCap]
jae WFF_HPCap
cvttsd2si eax,xmm0
test eax,eax
jns WFF_HPDone
WFF_HPZero:
xor eax,eax
jmp WFF_HPDone
WFF_HPCap:
mov eax,#2147483000
WFF_HPDone:
popfq
movd xmm0,eax
jmp WFF_HPApply+8
align 10
WFF_GodMode:
db 00
WFF_MaxVitals:
db 00
WFF_OneHit:
db 00
align 8
WFF_PlayerDamage:
dq (double)1.0
WFF_EnemyDamage:
dq (double)1.0
WFF_DamageCap:
dq (double)2147483000.0
WFF_LastHPActor:
dq 0
WFF_HPApply:
jmp WFF_HPCode
nop 3
[DISABLE]
WFF_HPApply:
db F3 0F 2C C7 66 0F 6E C0
unregistersymbol(WFF_HPApply)
unregistersymbol(WFF_GodMode)
unregistersymbol(WFF_MaxVitals)
unregistersymbol(WFF_OneHit)
unregistersymbol(WFF_PlayerDamage)
unregistersymbol(WFF_EnemyDamage)
unregistersymbol(WFF_LastHPActor)
dealloc(WFF_HPCode)
</AssemblerScript>
