aobscanmodule(WFF_CaptureReady,WOFF.exe,33 C0 0F 57 C0 0F 2F 41 10 0F 92 C0 89 02 48 8B C2 C3)
aobscanmodule(WFF_CaptureChance,WOFF.exe,F3 0F 10 BB E8 34 00 00 F3 0F 58 BB 48 2B 00 00 0F 2F FE 76 7C)
