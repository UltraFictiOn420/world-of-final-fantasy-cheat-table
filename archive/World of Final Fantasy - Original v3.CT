local b=getAddressSafe('WOFF.exe')
if not b then error('Start WoFF and load a save first.') end
local pe=readInteger(b+0x3C)
if not pe or readInteger(b+pe+8)~=0x5B9B7E76 then
  error('Unverified WoFF executable build; no patches applied.')
end
{$asm}

aobscanmodule(WFF_APRegen,WOFF.exe,F3 0F 11 B7 D0 29 00 00 48 8B 0D ?? ?? ?? ?? 48 8B 01 FF 90 40 02 00 00)
assert(WFF_APRegen,F3 0F 11 B7 D0 29 00 00)
alloc(WFF_APRegenCode,256,WFF_APRegen)
label(WFF_APRegenOriginal)
label(WFF_APRegenDone)
registersymbol(WFF_APRegen)
WFF_APRegenCode:
pushfq
cmp dword ptr [rdi+2E34],0
jne WFF_APRegenOriginal
sub rsp,10
movups [rsp],xmm0
movss xmm0,[rdi+29D4]
movss [rdi+29D0],xmm0
movups xmm0,[rsp]
add rsp,10
jmp WFF_APRegenDone
WFF_APRegenOriginal:
movss [rdi+29D0],xmm6
WFF_APRegenDone:
popfq
jmp WFF_APRegen+8
WFF_APRegen:
jmp WFF_APRegenCode
nop 3
aobscanmodule(WFF_APSet,WOFF.exe,F3 0F 11 B3 D0 29 00 00 0F 28 74 24 30 0F 28 7C 24 20)
assert(WFF_APSet,F3 0F 11 B3 D0 29 00 00)
alloc(WFF_APSetCode,256,WFF_APSet)
label(WFF_APSetOriginal)
label(WFF_APSetDone)
registersymbol(WFF_APSet)
WFF_APSetCode:
pushfq
cmp dword ptr [rbx+2E34],0
jne WFF_APSetOriginal
sub rsp,10
movups [rsp],xmm0
movss xmm0,[rbx+29D4]
movss [rbx+29D0],xmm0
movups xmm0,[rsp]
add rsp,10
jmp WFF_APSetDone
WFF_APSetOriginal:
movss [rbx+29D0],xmm6
WFF_APSetDone:
popfq
jmp WFF_APSet+8
WFF_APSet:
jmp WFF_APSetCode
nop 3
aobscanmodule(WFF_APDamage,WOFF.exe,F3 0F 11 B3 D0 29 00 00 48 8B 5C 24 58 48 8B 74 24 60)
assert(WFF_APDamage,F3 0F 11 B3 D0 29 00 00)
alloc(WFF_APDamageCode,256,WFF_APDamage)
label(WFF_APDamageOriginal)
label(WFF_APDamageDone)
registersymbol(WFF_APDamage)
WFF_APDamageCode:
pushfq
cmp dword ptr [rbx+2E34],0
jne WFF_APDamageOriginal
sub rsp,10
movups [rsp],xmm0
movss xmm0,[rbx+29D4]
movss [rbx+29D0],xmm0
movups xmm0,[rsp]
add rsp,10
jmp WFF_APDamageDone
WFF_APDamageOriginal:
movss [rbx+29D0],xmm6
WFF_APDamageDone:
popfq
jmp WFF_APDamage+8
WFF_APDamage:
jmp WFF_APDamageCode
nop 3
[DISABLE]
WFF_APRegen:
db F3 0F 11 B7 D0 29 00 00
unregistersymbol(WFF_APRegen)
