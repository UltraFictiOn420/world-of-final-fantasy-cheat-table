[ENABLE]
{$lua}
if syntaxcheck then return end
-- Never reopen the process inside AA: it can invalidate AA's captured handle.
if getOpenedProcessID()~=getProcessIDFromProcessName('WOFF.exe') then
  error('Select WOFF.exe in Cheat Engine before enabling the table.')
end
local b=getAddressSafe('WOFF.exe')
if not b then error('Start WoFF and load a save first.') end
local pe=readInteger(b+0x3C)
if not pe or readInteger(b+pe+8)~=0x5B9B7E76 then
  error('Unverified WoFF executable build; no patches applied.')
end
{$asm}

// Caller is the ordinary defeated-enemy drop loop. Earlier native checks
// require a loot-eligible defeated actor, valid item ID, and positive rate.
aobscanmodule(WFF_LootRoll,WOFF.exe,0F 2F F0 0F 83 F6 01 00 00 48 8B EE 49 8B CD)
assert(WFF_LootRoll,0F 2F F0 0F 83 F6 01 00 00)
alloc(WFF_LootCode,256,WFF_LootRoll)
label(WFF_LootReturn)
label(WFF_LootHits)
registersymbol(WFF_LootRoll)
registersymbol(WFF_LootHits)
WFF_LootCode:
pushfq
lock inc dword ptr [WFF_LootHits]
popfq
// Preserve the native comparison flags; bypass only its failure branch.
comiss xmm6,xmm0
jmp WFF_LootReturn
align 10
WFF_LootHits:
dd 0
WFF_LootRoll:
jmp WFF_LootCode
nop 4
WFF_LootReturn:
[DISABLE]
WFF_LootRoll:
db 0F 2F F0 0F 83 F6 01 00 00
unregistersymbol(WFF_LootHits)
unregistersymbol(WFF_LootRoll)
dealloc(WFF_LootCode)
