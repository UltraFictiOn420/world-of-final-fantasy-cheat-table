<?xml version='1.0' encoding='utf-8'?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>1</ID>
      <Description>"World of Final Fantasy - Original v1 [Foundation / Test]"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
openProcess('WOFF.exe')
local b=getAddressSafe('WOFF.exe')
if not b then error('Start WoFF and load a save first.') end
local pe=readInteger(b+0x3C)
if not pe or readInteger(b+pe+8)~=0x5B9B7E76 then
  error('Unverified WoFF executable build; no patches applied.')
end
{$asm}
// Cost-availability check and spending are independent, but share our flags.
aobscanmodule(WFF_SPCheck,WOFF.exe,0F B7 80 E8 00 00 00 3B C3 0F 93 C0 48 83 C4 20 5B C3 CC)
aobscanmodule(WFF_SPCheckBase,WOFF.exe,0F B7 80 E8 00 00 00 3B C3 0F 93 C0 48 83 C4 20 5B C3 48 83 FA 03)
aobscanmodule(WFF_SPSpend,WOFF.exe,0F B7 81 E8 00 00 00 3B C3 72 2B 66 2B C3 66 01 99 EA 00 00 00)
assert(WFF_SPCheck+9,0F 93 C0 48 83 C4 20)
assert(WFF_SPCheckBase+9,0F 93 C0 48 83 C4 20)
assert(WFF_SPSpend+9,72 2B 66 2B C3)
alloc(WFF_BoardCode,512,WFF_SPCheck)
label(WFF_CFG)
label(WFF_Availability)
label(WFF_AvailabilityBase)
label(WFF_EvaluateSP)
label(WFF_AvailabilityDone)
label(WFF_Spending)
label(WFF_ApplyCost)
label(WFF_KeepSP)
label(WFF_PaySP)
label(WFF_SPFailure)
registersymbol(WFF_CFG)
registersymbol(WFF_SPCheck)
registersymbol(WFF_SPCheckBase)
registersymbol(WFF_SPSpend)

WFF_BoardCode:
WFF_CFG:
db 00 00
align 10
WFF_Availability:
call WFF_EvaluateSP
add rsp,20
jmp WFF_SPCheck+10
WFF_AvailabilityBase:
call WFF_EvaluateSP
add rsp,20
jmp WFF_SPCheckBase+10
WFF_EvaluateSP:
// Preserve the original comparison result before consulting our option.
setae al
pushfq
cmp byte ptr [WFF_CFG],0
je WFF_AvailabilityDone
mov al,1
WFF_AvailabilityDone:
popfq
ret

WFF_Spending:
cmp byte ptr [WFF_CFG],0
jne WFF_ApplyCost
// Recreate the original affordability comparison when Ignore SP is disabled.
cmp eax,ebx
jb WFF_SPFailure
WFF_ApplyCost:
cmp byte ptr [WFF_CFG+1],0
jne WFF_KeepSP
cmp eax,ebx
jae WFF_PaySP
// Ignore SP never lets a 16-bit point balance wrap below zero.
xor eax,eax
jmp WFF_KeepSP
WFF_PaySP:
sub ax,bx
WFF_KeepSP:
jmp WFF_SPSpend+E
WFF_SPFailure:
jmp WFF_SPSpend+36

WFF_SPCheck+9:
jmp WFF_Availability
nop 2
WFF_SPCheckBase+9:
jmp WFF_AvailabilityBase
nop 2
WFF_SPSpend+9:
jmp WFF_Spending

[DISABLE]
WFF_SPCheck+9:
db 0F 93 C0 48 83 C4 20
WFF_SPCheckBase+9:
db 0F 93 C0 48 83 C4 20
WFF_SPSpend+9:
db 72 2B 66 2B C3
unregistersymbol(WFF_CFG)
unregistersymbol(WFF_SPCheck)
unregistersymbol(WFF_SPCheckBase)
unregistersymbol(WFF_SPSpend)
dealloc(WFF_BoardCode)
</AssemblerScript>
      <Options moDeactivateChildrenAsWell="1" />
      <CheatEntries>
        <CheatEntry>
          <ID>10</ID>
          <Description>"Infinite Gil - Hold 9,999,999 [Test; balance stays after disable]"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if WFF_GilTimer then error('Gil hold is already active.') end
local b=getAddressSafe('WOFF.exe')
if not b then error('Enable the table first.') end
local pid=getOpenedProcessID()
local function gilAddress()
  if getOpenedProcessID()~=pid then return nil end
  local root=readQword(b+0x3439EC0)
  if not root or root&lt;0x10000 or root&gt;=0x7FFFFFFFFFFF then return nil end
  local a=root+0x37368
  local v=readInteger(a)
  if not v or v&lt;0 or v&gt;9999999 then return nil end
  return a
end
if not gilAddress() then error('Gil data unavailable. Load your save first.') end
WFF_GilTimer=createTimer(nil,false)
WFF_GilTimer.Interval=100
WFF_GilTimer.OnTimer=function()
  local a=gilAddress()
  if a then writeInteger(a,9999999) end
end
WFF_GilTimer.Enabled=true
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if WFF_GilTimer then
  WFF_GilTimer.Enabled=false
  WFF_GilTimer.destroy()
  WFF_GilTimer=nil
end
{$asm}
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>11</ID>
          <Description>"Current Gil (editable)"</Description>
          <VariableType>4 Bytes</VariableType>
          <Address>WOFF.exe+3439EC0</Address>
          <Offsets>
            <Offset>37368</Offset>
          </Offsets>
        </CheatEntry>
        <CheatEntry>
          <ID>20</ID>
          <Description>"Ignore SP Cost Requirement [Test]"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
WFF_CFG+0:
db 01
[DISABLE]
WFF_CFG+0:
db 00
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>21</ID>
          <Description>"Infinite SP - No Deduction [Test]"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
WFF_CFG+1:
db 01
[DISABLE]
WFF_CFG+1:
db 00
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>30</ID>
          <Description>"XP Multiplier [Test; 1 = normal, 0 = none]"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
aobscanmodule(WFF_XPGain,WOFF.exe,48 89 5C 24 10 48 89 6C 24 18 48 89 74 24 20 57 41 54 41 55 41 56 41 57 48 81 EC 30 02 00 00 48 8B 05 ?? ?? ?? ?? 8B D9 8B F2)
assert(WFF_XPGain,48 89 5C 24 10)
alloc(WFF_XPCode,256,WFF_XPGain)
label(WFF_XPFactor)
label(WFF_XPCap)
label(WFF_XPReturn)
label(WFF_XPRestore)
registersymbol(WFF_XPFactor)
registersymbol(WFF_XPGain)

WFF_XPCode:
mov [rsp+10],rbx
pushfq
// A factor of exactly one is a true no-op, even for large integer rewards.
cmp dword ptr [WFF_XPFactor],3F800000
je WFF_XPReturn
test edx,edx
js WFF_XPReturn
// Do not modify the reward record in place: it may be read more than once.
// Preserve XMM0; the integer argument alone is scaled for this call.
sub rsp,10
movups [rsp],xmm0
cvtsi2ss xmm0,edx
mulss xmm0,[WFF_XPFactor]
ucomiss xmm0,xmm0
jp WFF_XPRestore
minss xmm0,[WFF_XPCap]
maxss xmm0,[WFF_XPCap+4]
cvttss2si edx,xmm0
WFF_XPRestore:
movups xmm0,[rsp]
add rsp,10
WFF_XPReturn:
popfq
jmp WFF_XPGain+5
align 10
WFF_XPFactor:
dd (float)1.0
WFF_XPCap:
dd (float)2147483520.0
dd (float)0.0

WFF_XPGain:
jmp WFF_XPCode

[DISABLE]
WFF_XPGain:
db 48 89 5C 24 10
unregistersymbol(WFF_XPFactor)
unregistersymbol(WFF_XPGain)
dealloc(WFF_XPCode)
</AssemblerScript>
          <Options moDeactivateChildrenAsWell="1" />
          <CheatEntries>
            <CheatEntry>
              <ID>31</ID>
              <Description>"XP Factor (0 to 100 recommended)"</Description>
              <VariableType>Float</VariableType>
              <Address>WFF_XPFactor</Address>
              <DropDownList ReadOnly="0" DescriptionOnly="1" DisplayValueAsItem="1">0:No XP
1:Normal
2:2x
5:5x
10:10x
20:20x
100:100x</DropDownList>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
  </CheatEntries>
  <UserdefinedSymbols />
  <Comments>Original implementation. DrummerIX reference CT was read for context only; addresses and machine instructions were independently checked in the running game. No third-party scripts are embedded. Enable parent first. All features require gameplay testing. Disable children before parent, and disable everything before closing Cheat Engine. Gil changes remain after disabling. SP options share hooks and can be combined. Other requested battle/capture/item features are not yet implemented.</Comments>
</CheatTable>