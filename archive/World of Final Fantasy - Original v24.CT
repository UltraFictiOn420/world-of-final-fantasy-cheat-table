        <CheatEntry>
          <ID>90</ID>
          <Description>"Save Anywhere - Field Menu [Reopen menu after toggling; separate save slot recommended]"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>// Shared define must be available during both enable AND disable assembly.
define(WFF_SaveDescriptor,WOFF.exe+2B02278)
[ENABLE]
{$lua}
if syntaxcheck then return end
-- Never reopen the process inside AA: it can invalidate AA's captured handle.
if getOpenedProcessID()~=getProcessIDFromProcessName('WOFF.exe') then
  error('Select WOFF.exe in Cheat Engine before enabling the table.')
end
local b=getAddressSafe('WOFF.exe')
if not b then error('Start WoFF and load a save first.') end
local pe=readInteger(b+0x3C)
if not pe or readInteger(b+pe+8)~=0x5B9B7E76 then
  error('Unverified WoFF executable build; no patches applied.')
end
{$asm}

// The native field-menu descriptor for entry 9 (Save, menu type 0B).
// Its +20 field requires event flag 0FAC. -1 means no required flag,
// exactly as used by the other unrestricted menu entries.
// Changes only this static descriptor, not the persistent event-flag store.
assert(WFF_SaveDescriptor+10,0B 00 00 00 00 00 00 00 FF FF FF FF FF FF FF FF AC 0F 00 00 00 00 00 00)
WFF_SaveDescriptor+20:
dd FFFFFFFF
[DISABLE]
WFF_SaveDescriptor+20:
dd 00000FAC
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>100</ID>
          <Description>"Guaranteed Enemy Loot + Alternative Drops [Defeat enemies; native quantities]"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- Never reopen the process inside AA: it can invalidate AA's captured handle.
if getOpenedProcessID()~=getProcessIDFromProcessName('WOFF.exe') then
  error('Select WOFF.exe in Cheat Engine before enabling the table.')
end
local b=getAddressSafe('WOFF.exe')
if not b then error('Start WoFF and load a save first.') end
local pe=readInteger(b+0x3C)
if not pe or readInteger(b+pe+8)~=0x5B9B7E76 then
  error('Unverified WoFF executable build; no patches applied.')
end
{$asm}

// Caller is the ordinary defeated-enemy drop loop. Earlier native checks
// require a loot-eligible defeated actor, valid item ID, and positive rate.
aobscanmodule(WFF_LootRoll,WOFF.exe,0F 2F F0 0F 83 F6 01 00 00 48 8B EE 49 8B CD)
assert(WFF_LootRoll,0F 2F F0 0F 83 F6 01 00 00)
// Bypass the first-success exclusion only inside this defeated-enemy loop.
// The following null, invalid-ID and positive-chance guards remain native.
aobscanmodule(WFF_LootAlternatives,WOFF.exe,85 C0 0F 84 6F 02 00 00 48 85 FF 0F 84 66 02 00 00)
assert(WFF_LootAlternatives+2,0F 84 6F 02 00 00)
registersymbol(WFF_LootAlternatives)
alloc(WFF_LootCode,256,WFF_LootRoll)
label(WFF_LootReturn)
label(WFF_LootHits)
registersymbol(WFF_LootRoll)
registersymbol(WFF_LootHits)
WFF_LootCode:
pushfq
lock inc dword ptr [WFF_LootHits]
popfq
// Preserve the native comparison flags; bypass only its failure branch.
comiss xmm6,xmm0
jmp WFF_LootReturn
align 10
WFF_LootHits:
dd 0
WFF_LootRoll:
jmp WFF_LootCode
nop 4
WFF_LootReturn:
WFF_LootAlternatives+2:
nop 6
[DISABLE]
WFF_LootAlternatives+2:
db 0F 84 6F 02 00 00
unregistersymbol(WFF_LootAlternatives)
WFF_LootRoll:
db 0F 2F F0 0F 83 F6 01 00 00
unregistersymbol(WFF_LootHits)
unregistersymbol(WFF_LootRoll)
dealloc(WFF_LootCode)
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>110</ID>
          <Description>"Party Battle Status Options - Enable [TEST]"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- Never reopen the process inside AA: it can invalidate AA's captured handle.
if getOpenedProcessID()~=getProcessIDFromProcessName('WOFF.exe') then
  error('Select WOFF.exe in Cheat Engine before enabling the table.')
end
local b=getAddressSafe('WOFF.exe')
if not b then error('Start WoFF and load a save first.') end
local pe=readInteger(b+0x3C)
if not pe or readInteger(b+pe+8)~=0x5B9B7E76 then
  error('Unverified WoFF executable build; no patches applied.')
end
{$asm}

aobscanmodule(WFF_StatusTick,WOFF.exe,85 87 B0 2A 00 00 0F 84 D7 09 00 00 46 0F 2F 84 AF 7C 33 00 00)
aobscanmodule(WFF_StatusApply,WOFF.exe,44 89 4C 24 20 89 54 24 10 55 53 56 57 41 55 41 56 41 57)
assert(WFF_StatusTick,85 87 B0 2A 00 00)
assert(WFF_StatusApply,44 89 4C 24 20)
alloc(WFF_StatusCode,4096,WFF_StatusTick)
label(WFF_StatusCFG)
aobscanmodule(WFF_StatusEarly,WOFF.exe,8B 91 70 29 00 00 48 8B F9 8B 89 68 29 00 00)
assert(WFF_StatusEarly,8B 91 70 29 00 00)
alloc(WFF_StatusEarlyCode,2048,WFF_StatusEarly)
label(WFF_StatusEarlyRestore)
label(WFF_StatusEarlyLoop)
label(WFF_StatusEarlyNext)
label(WFF_StatusEarlyCheck)
label(WFF_StatusEarlyMembers)
label(WFF_StatusEarlyApply)
label(WFF_StatusEarlyCalls)
label(WFF_StatusEarlySeen)
label(WFF_StatusEarlyMemberLoop)
label(WFF_StatusEarlyMemberNext)
registersymbol(WFF_StatusEarly)
registersymbol(WFF_StatusEarlyCalls)
registersymbol(WFF_StatusEarlySeen)
WFF_StatusEarlyCode:
// Actor update precedes the native command-menu status-clock gate.
// Ten pushes preserve flags/GPRs and retain the observed 16-byte alignment.
pushfq
push rax
push rcx
push rdx
push r8
push r9
push r10
push r11
push rdi
push r12
sub rsp,0A0
movups [rsp+40],xmm0
movups [rsp+50],xmm1
movups [rsp+60],xmm2
movups [rsp+70],xmm3
movups [rsp+80],xmm4
movups [rsp+90],xmm5
mov rdi,rcx
cmp dword ptr [rdi+2E34],0
jne WFF_StatusEarlyRestore
cmp dword ptr [rdi+29C8],0
jle WFF_StatusEarlyRestore
test byte ptr [rdi+29A8],2
jnz WFF_StatusEarlyRestore
mov rax,WOFF.exe+2F4B168
cmp [rdi],rax
je @f
mov rax,WOFF.exe+2F39FC0
cmp [rdi],rax
je @f
mov rax,WOFF.exe+2F49E78
cmp [rdi],rax
je @f
mov rax,WOFF.exe+2F3DF30
cmp [rdi],rax
jne WFF_StatusEarlyRestore
@@:
inc dword ptr [WFF_StatusEarlySeen]
mov r12d,9
WFF_StatusEarlyLoop:
cmp r12d,0B
je WFF_StatusEarlyNext
cmp r12d,0C
je @f
cmp r12d,0D
je WFF_StatusEarlyMembers
cmp byte ptr [WFF_StatusCFG+2],0
je WFF_StatusEarlyNext
jmp WFF_StatusEarlyCheck
@@:
cmp byte ptr [WFF_StatusCFG+1],0
je WFF_StatusEarlyNext
jmp WFF_StatusEarlyCheck
WFF_StatusEarlyMembers:
cmp byte ptr [WFF_StatusCFG],0
je WFF_StatusEarlyNext
WFF_StatusEarlyCheck:
mov eax,[rdi+2AB0]
bt eax,r12d
jnc WFF_StatusEarlyApply
mov rax,WOFF.exe+2F4B168
cmp [rdi],rax
jne WFF_StatusEarlyNext
mov r8,[rdi+3690]
mov r9,[rdi+3698]
mov rax,r9
sub rax,r8
cmp rax,18
ja WFF_StatusEarlyNext
WFF_StatusEarlyMemberLoop:
cmp r8,r9
jae WFF_StatusEarlyNext
mov rax,[r8]
test rax,rax
jz WFF_StatusEarlyNext
cmp dword ptr [rax+29C8],0
jle WFF_StatusEarlyMemberNext
mov eax,[rax+2AB0]
bt eax,r12d
jnc WFF_StatusEarlyApply
WFF_StatusEarlyMemberNext:
add r8,8
jmp WFF_StatusEarlyMemberLoop
WFF_StatusEarlyApply:
mov rcx,rdi
mov edx,r12d
mov r8d,1
xor r9d,r9d
mov dword ptr [rsp+20],1
mov qword ptr [rsp+28],0
mov dword ptr [rsp+30],0
mov rax,[rdi]
call qword ptr [rax+700]
inc dword ptr [WFF_StatusEarlyCalls]
WFF_StatusEarlyNext:
inc r12d
cmp r12d,0D
jle WFF_StatusEarlyLoop
WFF_StatusEarlyRestore:
movups xmm0,[rsp+40]
movups xmm1,[rsp+50]
movups xmm2,[rsp+60]
movups xmm3,[rsp+70]
movups xmm4,[rsp+80]
movups xmm5,[rsp+90]
add rsp,0A0
pop r12
pop rdi
pop r11
pop r10
pop r9
pop r8
pop rdx
pop rcx
pop rax
popfq
mov edx,[rcx+2970]
jmp WFF_StatusEarly+6
align 4
WFF_StatusEarlyCalls:
dd 0
WFF_StatusEarlySeen:
dd 0
label(WFF_StatusOriginal)
label(WFF_StatusSaved)
label(WFF_StatusWanted)
label(WFF_StatusPresent)
label(WFF_StatusFreeze)
label(WFF_StatusApplyCode)
label(WFF_StatusApplyOriginal)
label(WFF_StatusDenied)
label(WFF_StatusCalls)
label(WFF_StatusNeedApply)
label(WFF_StatusMemberLoop)
label(WFF_StatusMembersPresent)
label(WFF_StatusMemberMissing)
registersymbol(WFF_StatusTick)
registersymbol(WFF_StatusApply)
registersymbol(WFF_StatusCFG)
registersymbol(WFF_StatusCalls)
WFF_StatusCode:
pushfq
push rax
cmp dword ptr [rdi+2E34],0
jne WFF_StatusOriginal
mov rax,WOFF.exe+2F39FC0
cmp [rdi],rax
je WFF_StatusSaved
mov rax,WOFF.exe+2F4B168
cmp [rdi],rax
je WFF_StatusSaved
// Independently observed player-character/partner classes, including members.
mov rax,WOFF.exe+2F49E78
cmp [rdi],rax
je WFF_StatusSaved
mov rax,WOFF.exe+2F3DF30
cmp [rdi],rax
jne WFF_StatusOriginal
WFF_StatusSaved:
// This is inside the native battle update, not a CE worker thread.
// r12d/r13 identify the current status, and remain nonvolatile across calls.
cmp dword ptr [rdi+29C8],0
jle WFF_StatusOriginal
cmp r12d,0D
jne @f
cmp byte ptr [WFF_StatusCFG],0
jne WFF_StatusWanted
@@:
cmp r12d,0C
jne @f
cmp byte ptr [WFF_StatusCFG+1],0
jne WFF_StatusWanted
@@:
cmp r12d,9
je @f
cmp r12d,0A
jne WFF_StatusFreeze
@@:
cmp byte ptr [WFF_StatusCFG+2],0
je WFF_StatusFreeze
WFF_StatusWanted:
mov eax,[rdi+2AB0]
bt eax,r12d
jnc WFF_StatusNeedApply
// A stack's own flag alone does not prove its members received the status.
mov rax,WOFF.exe+2F4B168
cmp [rdi],rax
jne WFF_StatusPresent
push r8
push r9
mov r8,[rdi+3690]
mov r9,[rdi+3698]
mov rax,r9
sub rax,r8
cmp rax,18
ja WFF_StatusMembersPresent
WFF_StatusMemberLoop:
cmp r8,r9
jae WFF_StatusMembersPresent
mov rax,[r8]
test rax,rax
jz @f
cmp dword ptr [rax+29C8],0
jle @f
mov eax,[rax+2AB0]
bt eax,r12d
jnc WFF_StatusMemberMissing
@@:
add r8,8
jmp WFF_StatusMemberLoop
WFF_StatusMembersPresent:
pop r9
pop r8
jmp WFF_StatusPresent
WFF_StatusMemberMissing:
pop r9
pop r8
WFF_StatusNeedApply:
// Preserve every volatile register and provide x64 shadow/stack arguments.
push rcx
push rdx
push r8
push r9
push r10
push r11
sub rsp,0A0
movups [rsp+40],xmm0
movups [rsp+50],xmm1
movups [rsp+60],xmm2
movups [rsp+70],xmm3
movups [rsp+80],xmm4
movups [rsp+90],xmm5
mov rcx,rdi
mov edx,r12d
mov r8d,1
xor r9d,r9d
mov dword ptr [rsp+20],1
mov qword ptr [rsp+28],0
// Native seventh argument: zero propagates stack status to its members.
mov dword ptr [rsp+30],0
mov rax,[rdi]
call qword ptr [rax+700]
inc dword ptr [WFF_StatusCalls]
movups xmm0,[rsp+40]
movups xmm1,[rsp+50]
movups xmm2,[rsp+60]
movups xmm3,[rsp+70]
movups xmm4,[rsp+80]
movups xmm5,[rsp+90]
add rsp,0A0
pop r11
pop r10
pop r9
pop r8
pop rdx
pop rcx
WFF_StatusPresent:
WFF_StatusFreeze:
cmp byte ptr [WFF_StatusCFG+3],0
je WFF_StatusOriginal
// Explicit beneficial-status allowlist; no KO, Reflect or Berserk.
mov eax,0AABB600
bt eax,r12d
jnc WFF_StatusOriginal
mov eax,[rdi+2AB0]
bt eax,r12d
jnc WFF_StatusOriginal
// Protect/Shell have native hit counters as well as duration slots.
cmp r12d,9
jne @f
cmp dword ptr [rdi+3414],2
jae @f
mov dword ptr [rdi+3414],2
@@:
cmp r12d,0A
jne @f
cmp dword ptr [rdi+3418],2
jae @f
mov dword ptr [rdi+3418],2
@@:
cmp r12d,0C
je @f
// Keep non-Regen clocks positive, but let native Regen ticks run.
cmp dword ptr [rdi+r13*4+337C],3F800000
jae WFF_StatusOriginal
mov dword ptr [rdi+r13*4+337C],3F800000
jmp WFF_StatusOriginal
@@:
cmp dword ptr [rdi+3420],2
jge WFF_StatusOriginal
mov dword ptr [rdi+3420],2
WFF_StatusOriginal:
pop rax
popfq
test dword ptr [rdi+2AB0],eax
jmp WFF_StatusTick+6

WFF_StatusApplyCode:
pushfq
push rax
cmp byte ptr [WFF_StatusCFG+4],0
je WFF_StatusApplyOriginal
test r8d,r8d
je WFF_StatusApplyOriginal
cmp dword ptr [rcx+2E34],0
jne WFF_StatusApplyOriginal
mov rax,WOFF.exe+2F39FC0
cmp [rcx],rax
je @f
mov rax,WOFF.exe+2F4B168
cmp [rcx],rax
je @f
mov rax,WOFF.exe+2F49E78
cmp [rcx],rax
je @f
mov rax,WOFF.exe+2F3DF30
cmp [rcx],rax
jne WFF_StatusApplyOriginal
@@:
cmp edx,1
jb WFF_StatusApplyOriginal
cmp edx,1C
ja WFF_StatusApplyOriginal
mov eax,155441FE
bt eax,edx
jc WFF_StatusDenied
WFF_StatusApplyOriginal:
pop rax
popfq
mov [rsp+20],r9d
jmp WFF_StatusApply+5
WFF_StatusDenied:
pop rax
popfq
ret
align 10
WFF_StatusCFG:
db 00 00 00 00 00
align 4
WFF_StatusCalls:
dd 0
WFF_StatusTick:
jmp WFF_StatusCode
nop
WFF_StatusApply:
jmp WFF_StatusApplyCode
WFF_StatusEarly:
jmp WFF_StatusEarlyCode
nop
[DISABLE]
WFF_StatusEarly:
db 8B 91 70 29 00 00
WFF_StatusTick:
db 85 87 B0 2A 00 00
WFF_StatusApply:
db 44 89 4C 24 20
unregistersymbol(WFF_StatusTick)
unregistersymbol(WFF_StatusApply)
unregistersymbol(WFF_StatusCFG)
unregistersymbol(WFF_StatusCalls)
dealloc(WFF_StatusCode)
unregistersymbol(WFF_StatusEarly)
unregistersymbol(WFF_StatusEarlyCalls)
unregistersymbol(WFF_StatusEarlySeen)
dealloc(WFF_StatusEarlyCode)
</AssemblerScript>
