<?xml version='1.0' encoding='utf-8'?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>1</ID>
      <Description>"World of Final Fantasy - Original v24 [Enable First]"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- Never reopen the process inside AA: it can invalidate AA's captured handle.
if getOpenedProcessID()~=getProcessIDFromProcessName('WOFF.exe') then
  error('Select WOFF.exe in Cheat Engine before enabling the table.')
end
local b=getAddressSafe('WOFF.exe')
if not b then error('Start WoFF and load a save first.') end
local pe=readInteger(b+0x3C)
if not pe or readInteger(b+pe+8)~=0x5B9B7E76 then
  error('Unverified WoFF executable build; no patches applied.')
end
-- UI-only guards for information rows. No writes to game memory or settings.
local list=getAddressList()
local owner=list.getMemoryRecordByID(1)
if not owner then return end
if WFF_InfoGuard and WFF_InfoGuard.owner~=owner then
  WFF_InfoGuard.cleanup()
end
if WFF_InfoGuard then return end
local state={owner=owner,records={},events={}}
WFF_InfoGuard=state
for _,id in ipairs({83,84,85}) do
  local r=list.getMemoryRecordByID(id)
  if r then
    r.Active=false
    r.Color=0x808080
    state.records[id]=true
    r.OnActivate=function(record,before,currentstate)
      if before then return false end
      return true
    end
  end
end
-- CE returns fresh Lua wrappers for records, so key by stable ID and ancestry,
-- not by userdata table keys. Block dialogs only for this feature's info rows.
-- Retain
-- any previous handlers and delegate every unrelated row to them unchanged.
for _,event in ipairs({'OnValueChange','OnAddressChange','OnTypeChange','OnDescriptionChange'}) do
  local previous=list[event]
  local handler=function(addresslist,record)
    if record and state.records[record.ID] then
      local parent=record.Parent
      if parent and parent.ID==80 and parent.Parent and parent.Parent.ID==1 then
        return true
      end
    end
    if previous then return previous(addresslist,record) end
    return false
  end
  state.events[event]={previous=previous,handler=handler}
  list[event]=handler
end
state.cleanup=function()
  for event,binding in pairs(state.events) do
    if list[event]==binding.handler then list[event]=binding.previous end
  end
  if WFF_InfoGuard==state then WFF_InfoGuard=nil end
end
local previousDestroy=owner.OnDestroy
owner.OnDestroy=function()
  state.cleanup()
  if previousDestroy then previousDestroy() end
end

{$asm}
// Cost-availability check and spending are independent, but share our flags.
aobscanmodule(WFF_SPCheck,WOFF.exe,0F B7 80 E8 00 00 00 3B C3 0F 93 C0 48 83 C4 20 5B C3 CC)
aobscanmodule(WFF_SPCheckBase,WOFF.exe,0F B7 80 E8 00 00 00 3B C3 0F 93 C0 48 83 C4 20 5B C3 48 83 FA 03)
aobscanmodule(WFF_SPSpend,WOFF.exe,0F B7 81 E8 00 00 00 3B C3 72 2B 66 2B C3 66 01 99 EA 00 00 00)
assert(WFF_SPCheck,0F B7 80 E8 00 00 00 3B C3 0F 93 C0 48 83 C4 20)
assert(WFF_SPCheckBase,0F B7 80 E8 00 00 00 3B C3 0F 93 C0 48 83 C4 20)
assert(WFF_SPSpend,0F B7 81 E8 00 00 00 3B C3 72 2B 66 2B C3)
alloc(WFF_BoardCode,512,WFF_SPCheck)
label(WFF_CFG)
label(WFF_Availability)
label(WFF_AvailabilityBase)
label(WFF_EvaluateSP)
label(WFF_AvailabilityDone)
label(WFF_Spending)
label(WFF_ApplyCost)
label(WFF_KeepSP)
label(WFF_PaySP)
label(WFF_SPFailure)
registersymbol(WFF_CFG)
registersymbol(WFF_SPCheck)
registersymbol(WFF_SPCheckBase)
registersymbol(WFF_SPSpend)

WFF_BoardCode:
WFF_CFG:
db 00 00
align 10
WFF_Availability:
call WFF_EvaluateSP
add rsp,20
jmp WFF_SPCheck+10
WFF_AvailabilityBase:
call WFF_EvaluateSP
add rsp,20
jmp WFF_SPCheckBase+10
WFF_EvaluateSP:
// Preserve the original comparison result before consulting our option.
setae al
pushfq
cmp byte ptr [WFF_CFG],0
je WFF_AvailabilityDone
mov al,1
WFF_AvailabilityDone:
popfq
ret

WFF_Spending:
cmp byte ptr [WFF_CFG],0
jne WFF_ApplyCost
// Recreate the original affordability comparison when Ignore SP is disabled.
cmp eax,ebx
jb WFF_SPFailure
WFF_ApplyCost:
cmp byte ptr [WFF_CFG+1],0
jne WFF_KeepSP
cmp eax,ebx
jae WFF_PaySP
// Ignore SP never lets a 16-bit point balance wrap below zero.
xor eax,eax
jmp WFF_KeepSP
WFF_PaySP:
sub ax,bx
WFF_KeepSP:
jmp WFF_SPSpend+E
WFF_SPFailure:
jmp WFF_SPSpend+36

WFF_SPCheck+9:
jmp WFF_Availability
nop 2
WFF_SPCheckBase+9:
jmp WFF_AvailabilityBase
nop 2
WFF_SPSpend+9:
jmp WFF_Spending

[DISABLE]
WFF_SPCheck+9:
db 0F 93 C0 48 83 C4 20
WFF_SPCheckBase+9:
db 0F 93 C0 48 83 C4 20
WFF_SPSpend+9:
db 72 2B 66 2B C3
unregistersymbol(WFF_CFG)
unregistersymbol(WFF_SPCheck)
unregistersymbol(WFF_SPCheckBase)
unregistersymbol(WFF_SPSpend)
dealloc(WFF_BoardCode)
</AssemblerScript>
      <Options moDeactivateChildrenAsWell="1" />
      <CheatEntries>
        <CheatEntry>
          <ID>10</ID>
          <Description>"Infinite Gil - Hold 9,999,999 [Balance stays after disable]"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if WFF_GilTimer then error('Gil hold is already active.') end
local b=getAddressSafe('WOFF.exe')
if not b then error('Enable the table first.') end
local pid=getOpenedProcessID()
local function gilAddress()
  if getOpenedProcessID()~=pid then return nil end
  local root=readQword(b+0x3439EC0)
  if not root or root&lt;0x10000 or root&gt;=0x7FFFFFFFFFFF then return nil end
  local a=root+0x37368
  local v=readInteger(a)
  if not v or v&lt;0 or v&gt;9999999 then return nil end
  return a
end
if not gilAddress() then error('Gil data unavailable. Load your save first.') end
WFF_GilTimer=createTimer(nil,false)
WFF_GilTimer.Interval=100
WFF_GilTimer.OnTimer=function()
  local a=gilAddress()
  if a then writeInteger(a,9999999) end
end
WFF_GilTimer.Enabled=true
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if WFF_GilTimer then
  WFF_GilTimer.Enabled=false
  WFF_GilTimer.destroy()
  WFF_GilTimer=nil
end
{$asm}
</AssemblerScript>
