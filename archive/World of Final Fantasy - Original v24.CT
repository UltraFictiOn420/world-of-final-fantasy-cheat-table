            <CheatEntry>
              <ID>82</ID>
              <Description>"2. Arm ONE [Replacement appears in Mirage list AFTER battle; off/on to re-arm]"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
local id=readInteger('WFF_NextCaptureID')
if not id or id==0 then error('Choose a Mirage in the dropdown before arming replacement.') end
{$asm}
WFF_NextCaptureArmed:
dd 1
[DISABLE]
WFF_NextCaptureArmed:
dd 0
</AssemblerScript>
