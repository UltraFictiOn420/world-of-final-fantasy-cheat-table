        <CheatEntry>
          <ID>40</ID>
          <Description>"Battle HP Options - Enable [Test]"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- Never reopen the process inside AA: it can invalidate AA's captured handle.
if getOpenedProcessID()~=getProcessIDFromProcessName('WOFF.exe') then
  error('Select WOFF.exe in Cheat Engine before enabling the table.')
end
local b=getAddressSafe('WOFF.exe')
if not b then error('Start WoFF and load a save first.') end
local pe=readInteger(b+0x3C)
if not pe or readInteger(b+pe+8)~=0x5B9B7E76 then
  error('Unverified WoFF executable build; no patches applied.')
end
{$asm}

aobscanmodule(WFF_HPApply,WOFF.exe,F3 0F 2C C7 66 0F 6E C0 0F 5B C0 F3 0F 5C C8 F3 0F 5F CB)
assert(WFF_HPApply,F3 0F 2C C7 66 0F 6E C0)
alloc(WFF_HPCode,256,WFF_HPApply)
label(WFF_GodMode)
label(WFF_LastHPActor)
label(WFF_HPDone)
registersymbol(WFF_HPApply)
registersymbol(WFF_GodMode)
registersymbol(WFF_LastHPActor)
WFF_HPCode:
cvttss2si eax,xmm7
pushfq
mov [WFF_LastHPActor],rbx
// Only positive HP loss to the independently observed player side is blocked.
test eax,eax
jle WFF_HPDone
cmp dword ptr [rbx+2E34],0
jne WFF_HPDone
cmp byte ptr [WFF_GodMode],0
je WFF_HPDone
xor eax,eax
WFF_HPDone:
popfq
movd xmm0,eax
jmp WFF_HPApply+8
align 10
WFF_GodMode:
db 00
align 8
WFF_LastHPActor:
dq 0
WFF_HPApply:
jmp WFF_HPCode
nop 3
[DISABLE]
WFF_HPApply:
db F3 0F 2C C7 66 0F 6E C0
unregistersymbol(WFF_HPApply)
unregistersymbol(WFF_GodMode)
unregistersymbol(WFF_LastHPActor)
dealloc(WFF_HPCode)
</AssemblerScript>
          <Options moDeactivateChildrenAsWell="1" />
